{
  "name": "device-dock",
  "productName": "设备坞",
  "appId": "com.devicedock.app",
  "version": "4.1.1",
  "description": "设备坞：安卓设备管理、ADB 与投屏",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:preload\" \"npm run dev:renderer\"",
    "dev:main": "vite build --watch --config vite.main.mjs --mode=development",
    "dev:preload": "vite build --watch --config vite.preload.mjs --mode=development",
    "dev:renderer": "vite",
    "build:main": "vite build --config vite.main.mjs",
    "build:preload": "vite build --config vite.preload.mjs",
    "build:renderer": "vite build",
    "build": "zx script/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "zx script/pack.mjs",
    "pack:dir": "zx script/pack.mjs --dir",
    "pack:mas-dev": "zx script/pack.mjs --mas-dev",
    "pack:mas": "zx script/pack.mjs --mas",
    "pack:appx": "zx script/pack.mjs --appx",
    "adb": "zx script/adb.mjs",
    "server": "zx script/server.mjs",
    "format": "prettier \"src/**/*.{ts,tsx,scss,css,json}\" \"*.{js,mjs,ts,json}\" \"script/*.mjs\" --write",
    "start": "electron ./dist/main/index.js --inspect=9229",
    "start:debug": "electron ./dist/main/index.js --inspect=9229 --remote-debugging-port=9334",
    "test": "node script/test.mjs",
    "test:devices": "node script/device-matrix-e2e.mjs",
    "check": "npm run typecheck && npm test && npm run lint",
    "smoke": "node script/smoke.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "gen:icon": "node script/gen-icons.mjs",
    "gen:theme": "lsla genTheme --input src/common/theme.json --output src/renderer/theme.scss && lsla genTheme --input src/common/theme.json --output src/common/theme.ts",
    "gen:pb": "pbjs -t static-module -w es6 -o src/main/lib/wire.js server/server/src/main/proto/wire.proto && pbts -o src/main/lib/wire.d.ts src/main/lib/wire.js"
  },
  "keywords": [
    "adb",
    "android",
    "scrcpy"
  ],
  "author": {
    "name": "设备坞"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@devicefarmer/adbkit": "^3.3.8",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@yume-chan/no-data-view": "^1.0.0",
    "@yume-chan/pcm-player": "^1.0.0",
    "@yume-chan/scrcpy": "^1.1.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^1.1.0",
    "@yume-chan/stream-extra": "^1.0.0",
    "android-device-list": "^1.2.10",
    "axios": "^1.7.8",
    "concurrently": "^9.0.1",
    "custom-electron-titlebar": "^4.2.8",
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "fs-extra": "^11.2.0",
    "globals": "^15.11.0",
    "licia": "^1.48.0",
    "lsla": "^1.0.2",
    "lucide-static": "^1.72.0",
    "luna-command-palette": "^0.3.1",
    "luna-data-grid": "^2.0.2",
    "luna-dom-viewer": "^1.8.3",
    "luna-drag-selector": "^0.2.0",
    "luna-file-list": "^0.5.6",
    "luna-icon-list": "^0.2.5",
    "luna-image-viewer": "^1.1.0",
    "luna-logcat": "^0.6.3",
    "luna-menu": "^0.2.0",
    "luna-modal": "^1.3.3",
    "luna-music-player": "^1.0.0",
    "luna-music-visualizer": "^0.2.1",
    "luna-notification": "^0.3.3",
    "luna-otp-input": "^0.1.1",
    "luna-path-bar": "^0.3.0",
    "luna-performance-monitor": "^1.2.2",
    "luna-setting": "^2.0.2",
    "luna-split-pane": "^0.4.1",
    "luna-tab": "^0.4.3",
    "luna-text-viewer": "^0.3.0",
    "luna-toolbar": "^0.9.2",
    "luna-video-player": "^1.1.5",
    "luna-virtual-list": "^0.1.1",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.0.7",
    "prettier": "^3.10.1",
    "protobufjs": "^7.4.0",
    "protobufjs-cli": "^1.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resedit": "^1.7.2",
    "sass": "^1.80.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "yauzl": "^3.4.0",
    "zx": "^8.8.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  }
}
